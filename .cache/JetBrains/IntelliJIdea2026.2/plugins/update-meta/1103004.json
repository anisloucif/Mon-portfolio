{"id":1103004,"xmlId":"Karma","name":"Karma","description":"Provides <a href=\"https://karma-runner.github.io/\">Karma</a> support to all JetBrains IDEs that\n   <a href=\"https://www.jetbrains.com/products/#lang=js&amp;type=ide\">support JavaScript</a>.\n\n  <h3>Features</h3>\n  <ul>\n  <li>Test coverage with built-in running, debugging, and monitoring</li>\n  <li>Test results in treeview with easy navigation to test sources</li>\n  <li>Test statuses in the editor with options to run or debug</li>\n  </ul>\n\n  <h3>Getting started</h3>\n  For information on getting started, head over to the <a href=\"https://www.jetbrains.com/help/\">documentation</a> for your IDE.\n  For WebStorm, you can check out this section in the <a href=\"https://www.jetbrains.com/help/webstorm/running-unit-tests-on-karma.html\">documentation</a>.\n<h2>Getting started</h2>\n<a href=\"https://blog.jetbrains.com/webstorm/2013/10/running-javascript-tests-with-karma-in-webstorm-7\" rel=\"nofollow\">Running JavaScript tests with Karma in WebStorm</a>","organization":"JetBrains s.r.o.","tags":["Testing"],"version":"262.8665.177","dependencies":["intellij.javascript.common","intellij.javascript.backend","com.intellij.modules.lang","intellij.platform.testRunner","com.intellij.modules.scriptDebugger.ui","intellij.platform.smRunner","intellij.platform.coverage","intellij.platform.scriptDebugger.ui","com.intellij.modules.ultimate","intellij.javascript.psi.impl","intellij.javascript.analysis.impl","intellij.javascript.testing","JavaScript"],"optionalDependencies":["JavaScriptDebugger","com.intellij.modules.coverage"],"since":"262.8665","until":"262.*","size":227587,"vendor":"JetBrains","sourceCodeUrl":"https://github.com/JetBrains/intellij-plugins/tree/master/js-karma","depends":["com.intellij.modules.lang","JavaScript","com.intellij.modules.ultimate","com.intellij.modules.scriptDebugger.ui"],"optionalDepends":["JavaScriptDebugger","com.intellij.modules.coverage"],"mainModuleDependencies":[{"type":"modu