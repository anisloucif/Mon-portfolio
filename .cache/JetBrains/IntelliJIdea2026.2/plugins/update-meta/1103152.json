{"id":1103152,"xmlId":"com.jetbrains.plugins.webDeployment","name":"FTP/SFTP/WebDAV Connectivity","description":"Provides connectivity with remote hosts via FTP(S)/SFTP/WebDAV as well as lets you deploy files within the file system or provide web paths for them.<br><br>\n    The following features are available:<ul>\n      <li>Maintain a list of remote FTP(S)/SFTP/WebDAV server configurations (<a href=\"https://www.jetbrains.com/help/phpstorm/?deployment.configure.server.remote\">docs</a>)</li>\n      <li>Synchronize your project files with a remote server (<a href=\"https://www.jetbrains.com/help/phpstorm/?Deploying_Applications\">docs</a>)</li>\n      <li>Access remote interpreter on a SFTP server (<a href=\"https://www.jetbrains.com/help/phpstorm/?php.configure.remote.interpreter\">docs</a>)</li>\n    </ul>","organization":"JetBrains s.r.o.","tags":["Network"],"version":"262.8665.185","dependencies":["intellij.platform.ssh","intellij.platform.ssh.core","com.intellij.modules.ultimate","com.intellij.modules.ssh","com.intellij.modules.xml","com.intellij.modules.vcs","intellij.platform.ssh.ui","intellij.platform.backend"],"optionalDependencies":["com.intellij.modules.phpstorm"],"since":"262.8665","until":"262.*","size":1828651,"vendor":"JetBrains","mainModuleDependencies":[{"type":"plugin","pluginId":"com.intellij.modules.xml"},{"type":"plugin","pluginId":"com.intellij.modules.vcs"},{"type":"plugin","pluginId":"com.intellij.modules.ultimate"},{"type":"plugin","pluginId":"com.intellij.modules.ssh"},{"type":"module","moduleName":"intellij.platform.ssh"},{"type":"module","moduleName":"intellij.platform.ssh.core"},{"type":"module","moduleName":"intellij.platform.ssh.ui"}],"content":[{"moduleName":"intellij.webDeployment/phpStorm","namespace":null},{"moduleName":"intellij.platform.commercial.verifier","loadingRule":"embedded","namespace":null}],"modules":[{"moduleName":"intellij.webDeployment/phpStorm","moduleDependencies":[{"type":"plugin","pluginId":"com.intellij.module