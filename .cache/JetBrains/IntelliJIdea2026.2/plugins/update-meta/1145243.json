{"id":1145243,"xmlId":"org.intellij.plugins.markdown","name":"Markdown","description":"\n<p>Provides editing assistance for Markdown files within the IDE.</p>\n<br>\n<ul>\n<li>Full support for vanilla Markdown syntax: highlighting, completion, navigation, inspection, intentions, and much more.</li>\n<li>Live HTML preview, customizable with CSS (except Android Studio, see <a href=\"https://issuetracker.google.com/issues/159933628?pli=1#comment7\">issue and workaround</a>).</li>\n<li>Assistance for editing tables and lists: automatic alignment and numbering.</li>\n<li>Drag and drop to insert images.</li>\n<li>Language injection in code blocks.</li>\n<li>Pandoc Converter for HTML, Microsoft Word, and PDF formats.</li>\n<li>Support for PlantUML diagram rendering (you can add support for Mermaid diagrams with a <a href=\"https://plugins.jetbrains.com/plugin/20146-mermaid\">separate plugin</a>).</li>\n</ul>\n","organization":"JetBrains s.r.o.","tags":["Programming Language"],"version":"262.10315.19","dependencies":["com.intellij.modules.lang","intellij.platform.structureView"],"optionalDependencies":["intellij.java.indexing","intellij.platform.langInjection","intellij.yaml.backend","intellij.rd.platform","intellij.platform.backend","intellij.platform.frontend.split","intellij.platform.compose.markdown","intellij.platform.frontend","intellij.platform.kernel.backend","com.intellij.modules.xml","intellij.rd.ide.model.generated","com.intellij.platform.images","intellij.platform.ui.jcef","intellij.java.psi","org.toml.lang","intellij.json.backend","intellij.rd.client","intellij.java.impl","intellij.libraries.compose.foundation.desktop","intellij.rd.ui","intellij.markdown.fenceInjection","intellij.platform.backend.split","com.intellij.modules.jcef","intellij.libraries.coil","intellij.yaml","intellij.textmate","intellij.markdown","intellij.platform.compose","intellij.libraries.jcef","intellij.java.psi.impl","intellij.spellchecker"],"since":"262.10315","until":"262.*","size":20766