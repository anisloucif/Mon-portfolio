{"id":1145258,"xmlId":"tanvd.grazi","name":"Natural Languages","description":"<p>Intelligent spelling and grammar checks for any text you write in the IDE.</p>\n\n    <ul>\n      <li>\n        Supports over 20 languages, including English, German, Russian, and Chinese.\n        English is enabled by default.\n        To add other languages, open <b>Settings/Preferences | Editor | Natural Languages</b>.\n      </li>\n      <li>\n        Works with natural languages in programming language constructs (Python, Java, and others),\n        markup languages (Markdown, HTML, XML, and others), comments, and commit messages.\n      </li>\n      <li>Uses <a href=\"https://www.languagetool.org/\">LanguageTool</a> as its proofreading engine.</li>\n    </ul>\n\n    <p>Data privacy: all verification is performed locally, inside your IDE.</p>","organization":"JetBrains s.r.o.","tags":["Spellcheck"],"version":"262.10315.19","dependencies":["intellij.libraries.grpc","intellij.libraries.ai.grazie.spell.gec.engine.local","intellij.libraries.javax.activation","intellij.spellchecker","intellij.libraries.lucene.common","intellij.platform.vcs.impl","intellij.libraries.commons.text"],"optionalDependencies":["com.intellij.modules.xml","intellij.yaml.backend","intellij.java.psi","intellij.spellchecker.xml","intellij.json.backend","org.intellij.plugins.markdown","com.intellij.properties","intellij.java.backend","intellij.yaml","intellij.properties.backend","intellij.grazie.core","intellij.markdown","intellij.properties.backend.psi"],"since":"262.10315","until":"262.*","size":22002307,"vendor":"JetBrains","sourceCodeUrl":"https://github.com/JetBrains/intellij-community/tree/master/plugins/grazie","incompatibleWith":["com.intellij.jetbrains.client"],"mainModuleDependencies":[{"type":"module","moduleName":"intellij.spellchecker"},{"type":"module","moduleName":"intellij.platform.vcs.impl"}],"content":[{"moduleName":"intellij.grazie.core","loadingRule":"embedded","namespace":"jetbrains"},{"moduleN